DropConditions.MagicSoulGlobal: 所有敌人低概率掉落魔法精魂

Configs: {
	LocalConfig: {
		DisplayName: 本地设置
		Headers.Adjustments: 法术大修本地配置

		configEnableStartingBag: {
			Label: 启用初始巫师包
			Tooltip: 新建角色是否赠送{$Items.StarterBag}
		}

		configDisplayAetherAmuletCooldownDebuff: {
			Label: 显示以太护符冷却debuff（{$Items.AetherAmulet}效果）
			Tooltip: ""
		}

		ArcaneShieldBuffDisplayChoice: {
			Label: 魔法护盾提示显示方式
			Tooltip: 是否/如何显示护盾持续时间
		}

		configScreenshake: {
			Label: 模组武器屏幕震动
			Tooltip: 本模组武器是否触发画面抖动
		}
	}

	ServerConfig: {
		DisplayName: 服务器设置
		Headers.Adjustments: 法术大修服务器配置

		configMagicWeaponsAutoReuse: {
			Label: 魔法武器自动连发
			Tooltip: 所有魔法武器自动持续释放，其他模组武器同样生效
		}

		configEnablePrefixes: {
			Label: 启用全新附魔词缀
			Tooltip: 是否开启本模组专属前缀
		}

		configEnableVanillaRecipes: {
			Label: 原版装备新增配方
			Tooltip: 是否添加原版物品新合成方式
		}

		configEnableManaFlowerRework: {
			Label: 魔力花重做
			Tooltip:
				'''
				开启后魔力花大幅降低耗蓝、持续回蓝、暴击回蓝提升，
				但魔法伤害降低，且不会自动喝魔力药水
				'''
		}

		configEnableManaFlowerReworkNoManaPotions: {
			Label: 魔力花：禁用自动魔力药水
			Tooltip: 装备魔力花时，低蓝不会自动消耗魔力药剂
		}
	}

	BuffDisplayChoices: {
		Tooltip: ""

		None: {
			Label: 不显示
			Tooltip: ""
		}

		OnlyCooldown: {
			Label: 仅显示冷却
			Tooltip: ""
		}

		ActiveAndCooldown: {
			Label: 增益+冷却全部显示
			Tooltip: ""
		}
	}
}
