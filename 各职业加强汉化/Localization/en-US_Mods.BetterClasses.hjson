GhostGrabber: {
	Tooltip:
		'''
		按住左键蓄力，提高鞭子范围和伤害
		命中敌人时恢复灵魂，施加幽灵虚弱减益，并赋予幽灵化增益
		幽灵虚弱略微降低防御力，减慢移动速度，并造成快速持续伤害
		幽灵化略微提高灵魂恢复速度和灵魂值
		'''
	DisplayName: 幽灵抓取者
}

ShroomExplorerCoat: {
	Tooltip:
		'''
