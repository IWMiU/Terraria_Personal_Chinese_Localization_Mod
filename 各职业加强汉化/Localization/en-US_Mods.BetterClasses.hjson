Items: {
	AdamantiteArrowLauncher: {
		DisplayName: 精金箭矢发射器
		Tooltip:
			'''
			50%几率不消耗弹药
			从空中与身前射出各式随机箭矢
			感谢 AdamChromee 的支持！
			[c/ff000a:箭矢]
			[c/00b332:「记住，别去钓鱼」]
			[c/00fff7:贡献者物品]
			'''
	}

	AerialStorm: {
		DisplayName: 天穹风暴
		Tooltip:
			'''
			66%几率不消耗弹药
			每次射击射出一组高伤害箭矢，远程攻击速度提升3.5%
			远程攻速增益上限持续14秒
			'''
	}

	AncientScroll: {
		DisplayName: 古老卷轴
		Tooltip:
			'''
			蛊惑召唤物伤害与击退提升25%
			将玩家转变为亡灵僵尸
			僵尸形态移动速度降低且无法飞行
			但僵尸形态拥有更高生命值、生命恢复、伤害，所有亡灵生物对你友好
			'''
	}

	Apex: {
		DisplayName: 巅峰之矛
		Tooltip: 以长矛之力穿刺你的敌人
	}

	Apocalypse: {
		DisplayName: 天启
		Tooltip:
			'''
			左键挥击大量链球，同时投掷组合悠悠球，向敌人射出大量弹幕
			右键以众矛汇聚突刺，投掷大量标枪攻击敌人
			召唤多种陨石，每种陨石会为你和敌人附加不同增益与减益
			提升玩家伤害、生命值与防御力
			相信我，这武器「十分平衡」
			'''
	}

	ApprenticeEmblem: {
		DisplayName: 学徒徽章
		Tooltip: 魔法伤害提升8%
	}

	ArcaniumCuffs: {
		DisplayName: 奥能护腕
		Tooltip:
